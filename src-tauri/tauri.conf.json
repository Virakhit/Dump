{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dump",
  "version": "0.1.0",
  "identifier": "app.dump.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Dump", "width": 1100, "height": 780, "minWidth": 760, "minHeight": 580, "dragDropEnabled": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["dump"] } } }
}
